            },
            {
              "name": "indoor",
              "type": "boolean",
              "description": "True for indoor events, false for outdoor ones."
            },
            {
              "name": "categories",
              "type": "array"
            },
            {
              "name": "source_url",
              "type": "string"
            },
            {
              "name": "description",
              "type": "string"
            },
            {
              "name": "image_url",
              "type": "string"
            },
            {
              "name": "_source",
              "type": "object",
              "description": "Provenance: source_id, url, retrieved_at, mode, attribution."
            }
          ],
          "primaryKey": "id"
        }
      }
    ]
  }
